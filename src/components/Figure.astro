---
interface Props {
  src: string;
  caption?: string;
  alt?: string;
  width?: string;
  num?: string;
}

const { src, caption, alt = '', width, num } = Astro.props;
const fullCaption = num && caption ? `${num}. ${caption}` : caption;
---

<figure class="figure">
  <img
    src={src}
    alt={alt || caption || ''}
    style={width ? `max-width: ${width};` : undefined}
  />
  {fullCaption && <figcaption set:html={fullCaption} />}
</figure>
