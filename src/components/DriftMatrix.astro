---
---

<div class="drift-matrix-wrapper">
  <div class="drift-matrix" id="drift-matrix">
    <table>
      <thead>
        <tr>
          <th class="scenario-header"></th>
          <th>Qwen3.6</th>
          <th>GLM-5.1</th>
          <th>Kimi K2.6</th>
          <th>DS V4 Pro</th>
          <th>GPT-OSS</th>
        </tr>
      </thead>
      <tbody id="drift-tbody"></tbody>
    </table>
  </div>
  <div class="drift-detail" id="drift-detail">
    <div class="drift-detail-inner" id="drift-detail-inner">
      <button class="drift-detail-close" id="drift-detail-close" aria-label="Close">&times;</button>
      <div class="drift-detail-header">
        <span class="drift-detail-badge" id="drift-detail-badge"></span>
        <span class="drift-detail-title" id="drift-detail-title"></span>
      </div>
      <div class="drift-detail-body" id="drift-detail-body"></div>
    </div>
  </div>
</div>

<style>
  .drift-matrix-wrapper {
    margin: 1.5em 0;
    font-size: 0.92em;
  }
  .drift-matrix {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .drift-matrix table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 3px;
    table-layout: fixed;
  }
  .drift-matrix th {
    padding: 0.55em 0.5em;
    font-size: 0.85em;
    font-weight: 600;
    text-align: center;
    color: var(--text-secondary, #555);
    white-space: nowrap;
  }
  .drift-matrix th.scenario-header {
    width: 30%;
    min-width: 160px;
  }
  .drift-matrix td {
    text-align: center;
    padding: 0;
  }
  .drift-matrix td.scenario-label {
    text-align: left;
    padding: 0.5em 0.6em;
    font-size: 0.85em;
    font-weight: 500;
    color: var(--text-primary, #333);
    white-space: nowrap;
  }
  .drift-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5em 0.3em;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
    user-select: none;
    font-size: 1.1em;
    min-height: 2.2em;
    border: 2px solid transparent;
  }
  .drift-cell:hover {
    transform: scale(1.12);
    box-shadow: 0 2px 8px rgba(0,0,0,0.12);
    z-index: 1;
    position: relative;
  }
  .drift-cell.active {
    border-color: var(--accent, #4a90d9);
    box-shadow: 0 0 0 2px var(--accent, #4a90d9), 0 2px 12px rgba(74,144,217,0.25);
    transform: scale(1.08);
  }
  .drift-cell.pass {
    background: rgba(34, 197, 94, 0.12);
    color: #16a34a;
  }
  .drift-cell.conditional {
    background: rgba(234, 179, 8, 0.12);
    color: #b45309;
  }
  .drift-cell.fail {
    background: rgba(239, 68, 68, 0.12);
    color: #dc2626;
  }

  .drift-detail {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s ease, opacity 0.25s ease;
    opacity: 0;
    margin-top: 0;
  }
  .drift-detail.open {
    max-height: 600px;
    opacity: 1;
    margin-top: 0.75em;
  }
  .drift-detail-inner {
    position: relative;
    border-radius: 8px;
    padding: 1em 1.2em;
    border: 1px solid var(--border, #e0e0e0);
    background: var(--bg-secondary, #f8f9fa);
  }
  :root[data-theme="dark"] .drift-detail-inner,
  .dark .drift-detail-inner {
    background: #1a1a2e;
    border-color: #333;
  }
  .drift-detail-close {
    position: absolute;
    top: 0.4em;
    right: 0.6em;
    background: none;
    border: none;
    font-size: 1.4em;
    cursor: pointer;
    color: var(--text-secondary, #888);
    line-height: 1;
    padding: 0.1em 0.3em;
    border-radius: 4px;
  }
  .drift-detail-close:hover {
    background: rgba(0,0,0,0.06);
  }
  .drift-detail-header {
    display: flex;
    align-items: center;
    gap: 0.6em;
    margin-bottom: 0.6em;
  }
  .drift-detail-badge {
    display: inline-block;
    padding: 0.15em 0.6em;
    border-radius: 4px;
    font-size: 0.8em;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .drift-detail-badge.pass {
    background: rgba(34,197,94,0.15);
    color: #16a34a;
  }
  .drift-detail-badge.conditional {
    background: rgba(234,179,8,0.15);
    color: #b45309;
  }
  .drift-detail-badge.fail {
    background: rgba(239,68,68,0.15);
    color: #dc2626;
  }
  .drift-detail-title {
    font-weight: 600;
    font-size: 0.95em;
  }
  .drift-detail-body {
    font-size: 0.9em;
    line-height: 1.65;
    color: var(--text-primary, #333);
  }
  .drift-detail-body pre.drift-eg {
    background: rgba(234, 179, 8, 0.06);
    border-left: 3px solid rgba(234, 179, 8, 0.4);
    font-size: 0.82em;
    line-height: 1.5;
  }
  :root[data-theme="dark"] .drift-detail-body pre.drift-eg,
  .dark .drift-detail-body pre.drift-eg {
    background: rgba(234, 179, 8, 0.05);
    border-left-color: rgba(234, 179, 8, 0.3);
  }
  .drift-detail-body pre {
    background: var(--bg-code, #f0f0f0);
    border-radius: 6px;
    padding: 0.7em 0.9em;
    overflow-x: auto;
    font-size: 0.88em;
    margin: 0.5em 0;
    border: 1px solid var(--border, #ddd);
  }
  :root[data-theme="dark"] .drift-detail-body pre,
  .dark .drift-detail-body pre {
    background: #0d1117;
    border-color: #333;
  }
  .drift-detail-body code {
    font-family: 'Fira Code', 'JetBrains Mono', monospace;
  }
  .drift-detail-body .kw { color: #8250df; }
  .drift-detail-body .fn { color: #0550ae; }
  .drift-detail-body .str { color: #0a3069; }
  .drift-detail-body .cm { color: #6e7781; font-style: italic; }
  :root[data-theme="dark"] .drift-detail-body .kw,
  .dark .drift-detail-body .kw { color: #d2a8ff; }
  :root[data-theme="dark"] .drift-detail-body .fn,
  .dark .drift-detail-body .fn { color: #79c0ff; }
  :root[data-theme="dark"] .drift-detail-body .str,
  .dark .drift-detail-body .str { color: #a5d6ff; }
  :root[data-theme="dark"] .drift-detail-body .cm,
  .dark .drift-detail-body .cm { color: #8b949e; }

  @media (max-width: 640px) {
    .drift-matrix th, .drift-matrix td.scenario-label {
      font-size: 0.75em;
    }
    .drift-cell { font-size: 0.95em; padding: 0.4em 0.2em; }
    .drift-detail-inner { padding: 0.8em; }
  }
</style>

<script>
(function() {
  const MODELS = ["Qwen3.6", "GLM-5.1", "Kimi K2.6", "DS V4 Pro", "GPT-OSS"];
  const SCENARIOS = [
    "历史 thinking 保留",
    "reasoning 中换行",
    "</think> 后与 content 间换行",
    "reasoning 截断（无 </think>）",
    "tool_call 容错",
    "tool_call args 序列化"
  ];

  const S = { P: "pass", C: "conditional", F: "fail" };
  const ICON = { pass: "✓", conditional: "△", fail: "✗" };
  const LABEL = { pass: "不漂移", conditional: "条件性", fail: "漂移" };

  const DATA = [
    // scenario 0: 历史 thinking 保留
    [
      { s: S.C, t: "Qwen3.6 — 历史 thinking 保留",
        d: `默认只保留 last_query 之后的 assistant thinking。追加新 user 后，旧 assistant 的 <code>&lt;think&gt;...&lt;/think&gt;</code> 整块被删除。<br/><br/><strong>修复：</strong><code>preserve_thinking=True</code>`,
        e: `生成  ...&lt;think&gt;\\nLet me think.\\n&lt;/think&gt;\\n\\nThe answer is 42.\n\nparse reasoning_content = "Let me think."\n      content = "The answer is 42."\n\n重建  ...The answer is 42.\n      ↑ &lt;think&gt;...&lt;/think&gt;\\n\\n 整块删除`,
        c: `<span class="kw">{%- if</span> (preserve_thinking <span class="kw">is defined and</span> preserve_thinking <span class="kw">is true</span>)\n      <span class="kw">or</span> (loop.index0 > ns.last_query_index) <span class="kw">%}</span>\n  <span class="cm">{# render thinking #}</span>\n<span class="kw">{%- else %}</span>\n  <span class="cm">{# skip thinking, only render content #}</span>\n<span class="kw">{%- endif %}</span>`},
      { s: S.C, t: "GLM-5.1 — 历史 thinking 保留",
        d: `默认只保留 last_user 之后的 assistant thinking。更早的 assistant 的 thinking 被替换为一个孤立的 <code>&lt;/think&gt;</code>。<br/><br/><strong>修复：</strong><code>clear_thinking=False</code>`,
        e: `生成  ...&lt;think&gt;\\nLet me think.\\n&lt;/think&gt;The answer is 42.\n\nparse reasoning_content = "Let me think."\n      content = "The answer is 42."\n\n重建  ...&lt;/think&gt;The answer is 42.\n      ↑ &lt;think&gt;+reasoning 删除，保留孤立 &lt;/think&gt;`,
        c: `<span class="kw">{%- if</span> ((clear_thinking <span class="kw">is defined and not</span> clear_thinking)\n      <span class="kw">or</span> loop.index0 > ns.last_user_index)\n      <span class="kw">and</span> reasoning_content <span class="kw">is defined -%}</span>\n{{ <span class="str">'&lt;think&gt;'</span> + reasoning_content + <span class="str">'&lt;/think&gt;'</span> }}\n<span class="kw">{%- else -%}</span>\n{{ <span class="str">'&lt;/think&gt;'</span> }}  <span class="cm">{# 替换为孤立闭合标签 #}</span>\n<span class="kw">{%- endif -%}</span>`},
      { s: S.C, t: "Kimi K2.6 — 历史 thinking 保留",
        d: `基于 history/suffix 分区。最后一个非 tool-call assistant 之前的所有 assistant thinking 变为空 <code>&lt;think&gt;&lt;/think&gt;</code>。比其他模型更早触发——tool result 后追加 final answer 时就断裂。<br/><br/><strong>修复：</strong><code>preserve_thinking=True</code>`,
        e: `生成  ...&lt;think&gt;Let me think.&lt;/think&gt;The answer is 42.\n\nparse reasoning_content = "Let me think."\n      content = "The answer is 42."\n\n重建  ...&lt;think&gt;&lt;/think&gt;The answer is 42.\n      ↑ reasoning 清空为空标签`,
        c: `<span class="cm">{# hist_msgs 中的 assistant #}</span>\n<span class="kw">{%- if</span> message[<span class="str">'role'</span>] == <span class="str">'assistant'</span> <span class="kw">-%}</span>\n    &lt;think&gt;&lt;/think&gt;{{render_content(message)}}\n    <span class="cm">{# reasoning 固定替换为空 #}</span>`},
      { s: S.P, t: "DeepSeek V4 Pro — 历史 thinking 保留",
        d: `有 tools 时自动禁用 drop_thinking。只有无 tools 的对话中 <code>drop_thinking=True</code> 才会删除历史 reasoning。`,
        c: `effective_drop_thinking = drop_thinking\n<span class="kw">if</span> <span class="fn">any</span>(m.get(<span class="str">"tools"</span>) <span class="kw">for</span> m <span class="kw">in</span> full_messages):\n    effective_drop_thinking = <span class="kw">False</span>`},
      { s: S.C, t: "GPT-OSS — 历史 thinking 保留",
        d: `任何 tool-call assistant 的 analysis channel，只要后续存在 non-tool-call assistant 就被删除。非最后 assistant 的 thinking 也总是被丢弃。<br/><br/><strong>修复：</strong>Harmony 库 <code>auto_drop_analysis=False</code>`,
        e: `生成  ...&lt;|channel|&gt;analysis&lt;|message|&gt;Let me think.&lt;|end|&gt;...&lt;|channel|&gt;final&lt;|message|&gt;42.\n\nparse thinking = "Let me think."\n      content = "42."\n\n重建  ...&lt;|channel|&gt;final&lt;|message|&gt;42.\n      ↑ analysis channel 整段删除`,
        c: `<span class="kw">{%- set</span> future_final_message = namespace(found=<span class="kw">false</span>) <span class="kw">%}</span>\n<span class="kw">{%- for</span> future_message <span class="kw">in</span> loop_messages[loop.index:] <span class="kw">%}</span>\n  <span class="kw">{%- if</span> future_message.role == <span class="str">'assistant'</span>\n        <span class="kw">and</span> <span class="str">"tool_calls"</span> <span class="kw">not in</span> future_message <span class="kw">%}</span>\n    <span class="kw">{%- set</span> future_final_message.found = <span class="kw">true %}</span>\n  <span class="kw">{%- endif %}</span>\n<span class="kw">{%- endfor %}</span>`},
    ],
    // scenario 1: reasoning 中换行
    [
      { s: S.F, t: "Qwen3.6 — reasoning 中换行",
        d: `提取 reasoning 时做三重去除：<code>rstrip('\\n')</code> + <code>lstrip('\\n')</code> + <code>|trim</code>。然后 re-render 固定为 <code>&lt;think&gt;\\n{rc}\\n&lt;/think&gt;\\n\\n</code>。不论模型生成几个换行，都被统一为首尾各 1 个。`,
        e: `生成  &lt;think&gt;\\n\\nStep 1: check.\\nStep 2: call.\\n\\n&lt;/think&gt;\n\nparse reasoning_content = "Step 1: check.\\nStep 2: call."\n                           ↑ rstrip('\\n') + lstrip('\\n') + trim\n\n重建  &lt;think&gt;\\nStep 1: check.\\nStep 2: call.\\n&lt;/think&gt;\\n\\n\n      ↑ 首尾 \\n\\n → \\n，固定格式`,
        c: `<span class="cm"># vLLM (basic_parsers.py:L168)</span>\nafter = text[text.<span class="fn">find</span>(start)+<span class="fn">len</span>(start):]\nrc, _, content = after.<span class="fn">partition</span>(end)\n<span class="cm"># rc, content 保留原始空白</span>\n\n<span class="cm"># SGLang (reasoning_parser.py:L75)</span>\np = text.<span class="fn">replace</span>(start, <span class="str">""</span>).<span class="fn">strip</span>()\nrc, _, content = p.<span class="fn">partition</span>(end)\nrc = rc.<span class="fn">strip</span>(); content = content.<span class="fn">strip</span>()\n\n<span class="cm"># chat template（三重去除 + 固定格式）</span>\n<span class="kw">{%- set</span> rc = content.split(<span class="str">'&lt;/think&gt;'</span>)[0]\n      .<span class="fn">rstrip</span>(<span class="str">'\\n'</span>).split(<span class="str">'&lt;think&gt;'</span>)[-1]\n      .<span class="fn">lstrip</span>(<span class="str">'\\n'</span>) | <span class="fn">trim</span> <span class="kw">%}</span>`},
      { s: S.C, t: "GLM-5.1 — reasoning 中换行",
        d: `模板 split 提取时保留原始空白，re-render 直接拼接。但 SGLang reasoning_parser 对 reasoning_content 做 <code>.strip()</code>，会丢失首尾换行。vLLM 用 <code>partition()</code>，不 strip。`,
        e: `生成  &lt;think&gt;\\nStep 1: check.\\n&lt;/think&gt;The answer is 42.\n\nvLLM  reasoning_content = "\\nStep 1: check.\\n"   ← partition(), 零 strip\nSGLang reasoning_content = "Step 1: check."       ← .strip()\n\n重建  &lt;think&gt;Step 1: check.&lt;/think&gt;The answer is 42.\n      ↑ SGLang: 首尾 \\n 丢失`,
        c: `<span class="cm"># vLLM (basic_parsers.py:L168)</span>\nafter = text[text.<span class="fn">find</span>(start)+<span class="fn">len</span>(start):]\nrc, _, content = after.<span class="fn">partition</span>(end)\n<span class="cm"># rc, content 保留原始空白</span>\n\n<span class="cm"># SGLang (reasoning_parser.py:L75)</span>\np = text.<span class="fn">replace</span>(start, <span class="str">""</span>).<span class="fn">strip</span>()\nrc, _, content = p.<span class="fn">partition</span>(end)\nrc = rc.<span class="fn">strip</span>(); content = content.<span class="fn">strip</span>()\n\n<span class="cm"># chat template（不 strip）</span>\n{{ <span class="str">'&lt;think&gt;'</span> + rc + <span class="str">'&lt;/think&gt;'</span> }}`},
      { s: S.C, t: "Kimi K2.6 — reasoning 中换行",
        d: `模板 <code>&lt;think&gt;{{rc}}&lt;/think&gt;</code> 不加额外换行，不做 strip。但 SGLang 的 reasoning_parser 对 reasoning_content 做 <code>.strip()</code>（非 streaming）和 <code>.rstrip()</code>（streaming），会丢失首尾换行。vLLM 的 reasoning_parser 用 <code>partition()</code> 切片，不 strip。`,
        e: `生成  &lt;think&gt;\\nStep 1: check.\\n&lt;/think&gt;The answer is 42.\n\nvLLM  reasoning_content = "\\nStep 1: check.\\n"   ← partition(), 零 strip\nSGLang reasoning_content = "Step 1: check."       ← .strip()\n\n重建  &lt;think&gt;Step 1: check.&lt;/think&gt;The answer is 42.\n      ↑ SGLang: 首尾 \\n 丢失`,
        c: `<span class="cm"># vLLM (basic_parsers.py:L168)</span>\nafter = text[text.<span class="fn">find</span>(start)+<span class="fn">len</span>(start):]\nrc, _, content = after.<span class="fn">partition</span>(end)\n<span class="cm"># rc, content 保留原始空白</span>\n\n<span class="cm"># SGLang (reasoning_parser.py:L75)</span>\np = text.<span class="fn">replace</span>(start, <span class="str">""</span>).<span class="fn">strip</span>()\nrc, _, content = p.<span class="fn">partition</span>(end)\nrc = rc.<span class="fn">strip</span>(); content = content.<span class="fn">strip</span>()\n\n<span class="cm"># chat template（不 strip）</span>\n&lt;think&gt;{{rc}}&lt;/think&gt;{{render_content(msg)}}`},
      { s: S.P, t: "DeepSeek V4 Pro — reasoning 中换行",
        d: `<code>parse_message_from_completion_text</code> 用 <code>_read_until_stop</code> 保留所有原始空白。re-render 用 <code>thinking_template = "{reasoning_content}"</code> 直接拼接。`,
        c: `index, content_delta, stop_token = \\\n    <span class="fn">_read_until_stop</span>(index, text,\n        [thinking_end_token, ...])\nreasoning_content = content_delta\n<span class="cm"># 保留所有原始空白</span>`},
      { s: S.P, t: "GPT-OSS — reasoning 中换行",
        d: `analysis channel 用 special token 隔离：<code>&lt;|channel|&gt;analysis&lt;|message|&gt;{thinking}&lt;|end|&gt;</code>。thinking 内部换行不被修改。`,
        c: `<span class="cm">{# analysis 是独立 channel message #}</span>\n&lt;|start|&gt;assistant\n  &lt;|channel|&gt;analysis\n  &lt;|message|&gt;{{ message.thinking }}\n  &lt;|end|&gt;`},
    ],
    // scenario 2: </think> 后与 content 间换行
    [
      { s: S.C, t: "Qwen3.6 — </think> 后换行",
        d: `re-render 固定 <code>&lt;/think&gt;\\n\\n</code> 后接 content（已 trim）。只有模型恰好生成 2 个 <code>\\n</code> 时不漂移。1 个→2 个，3 个→2 个，0 个→2 个。`,
        e: `生成  &lt;/think&gt;\\nThe answer is 42.\n\nparse content = "The answer is 42."\n               ↑ lstrip('\\n') 去掉前导 \\n\n\n重建  &lt;/think&gt;\\n\\nThe answer is 42.\n               ↑ 固定 \\n\\n，原文只有 \\n`,
        c: `<span class="cm"># vLLM: partition 保留前导 \\n</span>\nafter = text[text.<span class="fn">find</span>(start)+<span class="fn">len</span>(start):]\nrc, _, content = after.<span class="fn">partition</span>(end)\n<span class="cm"># content = "\\nThe answer..."  保留前导 \\n</span>\n\n<span class="cm"># SGLang</span>\np = text.<span class="fn">replace</span>(start, <span class="str">""</span>).<span class="fn">strip</span>()\nrc, _, content = p.<span class="fn">partition</span>(end)\ncontent = content.<span class="fn">strip</span>()\n\n<span class="cm"># chat template: lstrip + 固定 \\n\\n</span>\n<span class="kw">{%- set</span> content = content\n    .split(<span class="str">'&lt;/think&gt;'</span>)[-1].<span class="fn">lstrip</span>(<span class="str">'\\n'</span>) <span class="kw">%}</span>\n{{- <span class="str">'\\n&lt;/think&gt;\\n\\n'</span> + content }}`},
      { s: S.F, t: "GLM-5.1 — </think> 后换行",
        d: `<code>content.strip()</code> 吞掉所有首尾空白。<code>&lt;/think&gt;\\n\\ncontent</code> → <code>&lt;/think&gt;content</code>。模型几乎总是在 <code>&lt;/think&gt;</code> 后生成换行——这意味着几乎总是漂移。`,
        e: `生成  &lt;/think&gt;\\n\\nThe answer is 42.\n\nparse content = "The answer is 42."\n               ↑ strip() 吞掉 \\n\\n\n\n重建  &lt;/think&gt;The answer is 42.\n               ↑ \\n\\n 消失`,
        c: `<span class="cm"># vLLM: partition 保留前导 \\n</span>\nafter = text[text.<span class="fn">find</span>(start)+<span class="fn">len</span>(start):]\nrc, _, content = after.<span class="fn">partition</span>(end)\n<span class="cm"># content = "\\nThe answer..."  保留前导 \\n</span>\n\n<span class="cm"># SGLang</span>\np = text.<span class="fn">replace</span>(start, <span class="str">""</span>).<span class="fn">strip</span>()\nrc, _, content = p.<span class="fn">partition</span>(end)\ncontent = content.<span class="fn">strip</span>()\n\n<span class="cm"># chat template: strip() 再次去除</span>\n<span class="kw">{%- if</span> content.<span class="fn">strip</span>() <span class="kw">-%}</span>\n{{ content.<span class="fn">strip</span>() }}`},
      { s: S.C, t: "Kimi K2.6 — </think> 后换行",
        d: `模板 <code>&lt;/think&gt;</code> 后直接接 <code>render_content</code>，无间隔。vLLM 的 reasoning_parser 用 <code>partition()</code> 保留 content 前导 <code>\\n</code>；SGLang 做 <code>.strip()</code> 丢失。`,
        e: `生成  &lt;/think&gt;\\nThe answer is 42.\n\nvLLM  content = "\\nThe answer is 42."    ← partition(), 保留前导 \\n\nSGLang content = "The answer is 42."     ← .strip()\n\n重建  &lt;/think&gt;The answer is 42.\n              ↑ SGLang: 前导 \\n 丢失`,
        c: `<span class="cm"># vLLM: partition 保留</span>\nafter = text[text.<span class="fn">find</span>(start)+<span class="fn">len</span>(start):]\nrc, _, content = after.<span class="fn">partition</span>(end)\n<span class="cm"># content = "\\nThe answer..."  保留前导 \\n</span>\n\n<span class="cm"># SGLang</span>\np = text.<span class="fn">replace</span>(start, <span class="str">""</span>).<span class="fn">strip</span>()\nrc, _, content = p.<span class="fn">partition</span>(end)\ncontent = content.<span class="fn">strip</span>()\n<span class="cm"># content = "The answer..."  前导 \\n 丢失</span>\n\n<span class="cm"># chat template（无间隔）</span>\n&lt;think&gt;{{rc}}&lt;/think&gt;{{render_content(msg)}}`},
      { s: S.P, t: "DeepSeek V4 Pro — </think> 后换行",
        d: `parse 时 <code>summary_content</code> 保留 <code>&lt;/think&gt;</code> 后的前导换行。re-render <code>{rc}&lt;/think&gt;{content}</code> 直接拼接，换行在 content 字段中。`,
        c: `<span class="cm"># assistant_msg_template 直接拼接</span>\nassistant_msg_template = \\\n    <span class="str">"{reasoning}{content}{tool_calls}"</span> + eos_token\n<span class="cm"># content = "\\nThe weather..." 保留前导 \\n</span>`},
      { s: S.P, t: "GPT-OSS — </think> 后换行",
        d: `不使用 <code>&lt;think&gt;</code> / <code>&lt;/think&gt;</code>。analysis 和 final 是独立 channel message，各自有 <code>&lt;|start|&gt;...&lt;|end|&gt;</code> 包裹，不存在换行拼接问题。`,
        c: `<span class="cm">{# 独立 channel，无拼接 #}</span>\n&lt;|start|&gt;assistant&lt;|channel|&gt;analysis\n  &lt;|message|&gt;...&lt;|end|&gt;\n&lt;|start|&gt;assistant&lt;|channel|&gt;final\n  &lt;|message|&gt;...&lt;|end|&gt;`},
    ],
    // scenario 3: reasoning 截断
    [
      { s: S.F, t: "Qwen3.6 — reasoning 截断",
        d: `模型因 max_tokens 截断，输出 <code>&lt;think&gt;\\nLet me think\\nste</code>（thinking 中间截断，无 <code>&lt;/think&gt;</code>）。re-render 补上闭合：<code>&lt;think&gt;\\nLet me think\\nste\\n&lt;/think&gt;\\n\\n</code>。多出的 <code>\\n&lt;/think&gt;\\n\\n</code> 是模型未生成的 token。`,
        e: `生成  &lt;think&gt;\\nLet me analyze this.\\nCheck the wea\n      ↑ max_tokens 截断，无 &lt;/think&gt;\n\nparse reasoning_content = "\\nLet me analyze this.\\nCheck the wea"\n      content = None                  ← partition() 未找到 &lt;/think&gt;\n\n重建  &lt;think&gt;\\nLet me analyze this.\\nCheck the wea\\n&lt;/think&gt;\\n\\n\n                                                ↑ 补上 \\n&lt;/think&gt;\\n\\n`,
        c: `<span class="cm"># vLLM: partition 找不到 &lt;/think&gt;</span>\nafter = text[text.<span class="fn">find</span>(start)+<span class="fn">len</span>(start):]\nrc, sep, content = after.<span class="fn">partition</span>(end)\n<span class="cm"># sep = "" → 未找到 end</span>\n<span class="cm"># rc = 整段, content = ""</span>\n\n<span class="cm"># chat template: 总是输出完整闭合</span>\n{{- <span class="str">'&lt;think&gt;\\n'</span> + rc\n    + <span class="str">'\\n&lt;/think&gt;\\n\\n'</span> + content }}`},
      { s: S.F, t: "GLM-5.1 — reasoning 截断",
        d: `类似 Qwen——parser 隐式截断后，re-render 补上 <code>&lt;/think&gt;</code>，多出模型未生成的闭合标签。`,
        e: `生成  &lt;think&gt;\\nLet me analyze this.\\nCheck the wea\n      ↑ 截断，无 &lt;/think&gt;\n\nparse reasoning_content = "\\nLet me analyze this.\\nCheck the wea"\n      content = None                  ← partition() 未找到 &lt;/think&gt;\n\n重建  &lt;think&gt;\\nLet me analyze this.\\nCheck the wea&lt;/think&gt;\n                                                ↑ 补上 &lt;/think&gt;`,
        c: `<span class="cm"># vLLM: partition 找不到 &lt;/think&gt;</span>\nafter = text[text.<span class="fn">find</span>(start)+<span class="fn">len</span>(start):]\nrc, sep, content = after.<span class="fn">partition</span>(end)\n<span class="cm"># sep = "" → 未找到 end</span>\n<span class="cm"># rc = 整段, content = ""</span>\n\n<span class="cm"># chat template: 总是输出完整闭合</span>\n{{ <span class="str">'&lt;think&gt;'</span> + rc + <span class="str">'&lt;/think&gt;'</span> }}`},
      { s: S.F, t: "Kimi K2.6 — reasoning 截断",
        d: `<code>&lt;|tool_calls_section_begin|&gt;</code> 作为隐式 <code>&lt;/think&gt;</code>。re-render 强制闭合 <code>&lt;think&gt;&lt;/think&gt;</code>，多出闭合标签。`,
        e: `生成  &lt;think&gt;Let me analyze this.\\nCheck the wea\n      ↑ 截断，无 &lt;/think&gt;\n\nparse reasoning_content = "Let me analyze this.\\nCheck the wea"\n      content = None                  ← partition() 未找到 &lt;/think&gt;\n\n重建  &lt;think&gt;Let me analyze this.\\nCheck the wea&lt;/think&gt;\n                                                ↑ 补上 &lt;/think&gt;`,
        c: `<span class="cm"># vLLM: partition 找不到 &lt;/think&gt;</span>\nafter = text[text.<span class="fn">find</span>(start)+<span class="fn">len</span>(start):]\nrc, sep, content = after.<span class="fn">partition</span>(end)\n<span class="cm"># sep = "" → 未找到 end</span>\n<span class="cm"># rc = 整段, content = ""</span>\n\n<span class="cm"># chat template: 总是输出完整闭合</span>\n&lt;think&gt;{{rc}}&lt;/think&gt;{{render_content(msg)}}`},
      { s: S.F, t: "DeepSeek V4 Pro — reasoning 截断",
        d: `与其他模型不同——parser 不做容错，直接 assert 失败。行为更安全（不会默默漂移），但调用方需要处理异常。`,
        e: `生成  &lt;think&gt;Let me analyze this.\\nCheck the wea\n      ↑ 截断，无 &lt;/think&gt;\n\nparse assert stop_token == thinking_end_token\n      → AssertionError: missing &lt;/think&gt;\n      ↑ 直接报错，拒绝处理`,
        c: `<span class="kw">assert</span> stop_token == thinking_end_token, \\\n    <span class="str">"Invalid thinking format: missing &lt;/think&gt;"</span>\n<span class="cm"># 截断时直接报错，不进入 re-render</span>`},
      { s: S.F, t: "GPT-OSS — reasoning 截断",
        d: `analysis channel 的 <code>&lt;|end|&gt;</code> 缺失时，parser 需要容错补上。补上的 token 是模型未生成的。`,
        e: `生成  &lt;|channel|&gt;analysis&lt;|message|&gt;Let me think about\n      ↑ 截断，无 &lt;|end|&gt;\n\nparse thinking = "Let me think about"\n\n重建  &lt;|channel|&gt;analysis&lt;|message|&gt;Let me think about&lt;|end|&gt;\n                                                      ↑ 补上 &lt;|end|&gt;`,
        c: `<span class="cm">{# L293: analysis channel #}</span>\n{{- <span class="str">"&lt;|start|&gt;assistant&lt;|channel|&gt;analysis</span>\n    <span class="str">&lt;|message|&gt;"</span> + message.thinking\n    + <span class="str">"&lt;|end|&gt;"</span> }}\n<span class="cm">{# 截断时 &lt;|end|&gt; 缺失，需容错补上 #}</span>`},
    ],
    // scenario 4: tool_call 容错
    [
      { s: S.C, t: "Qwen3.6 — tool_call 容错",
        d: `XML 格式每个 <code>&lt;parameter&gt;</code> 是独立块——已完成的参数能还原。但 re-render 补上 <code>&lt;/function&gt;\\n&lt;/tool_call&gt;</code> 闭合标签，多出模型未生成的 token。`,
        e: `生成  ...&lt;parameter=city&gt;\\nBeijing\\n&lt;/parameter&gt;\\n&lt;parameter=unit&gt;\\ncel\n      ↑ 第二个参数中间截断\n\nparse arguments = {"city": "Beijing"}   ← 已完成的 &lt;parameter&gt; 可独立解析\n\n重建  ...&lt;parameter=city&gt;\\nBeijing\\n&lt;/parameter&gt;\\n&lt;/function&gt;\\n&lt;/tool_call&gt;\n                                                    ↑ 补闭合标签`,
        c: `<span class="cm">{# L119-127: XML 参数格式 #}</span>\n{{- <span class="str">'&lt;parameter='</span> + args_name + <span class="str">'&gt;\\n'</span> }}\n{{- args_value }}\n{{- <span class="str">'\\n&lt;/parameter&gt;\\n'</span> }}\n...\n{{- <span class="str">'&lt;/function&gt;\\n&lt;/tool_call&gt;'</span> }}`},
      { s: S.C, t: "GLM-5.1 — tool_call 容错",
        d: `XML 格式，已完成的 <code>&lt;arg_key&gt;&lt;arg_value&gt;</code> 块可独立解析。同样需补闭合标签。`,
        e: `生成  ...&lt;arg_key&gt;city&lt;/arg_key&gt;\\n&lt;arg_value&gt;Beijing&lt;/arg_value&gt;\\n&lt;arg_key&gt;unit&lt;/arg_key&gt;\\n&lt;arg_value&gt;cel\n      ↑ 第二个参数中间截断\n\nparse arguments = {"city": "Beijing"}   ← 已完成的 key-value 可解析\n\n重建  ...&lt;arg_value&gt;Beijing&lt;/arg_value&gt;\\n&lt;/tool_call&gt;\n                                        ↑ 补闭合标签`,
        c: `&lt;tool_call&gt;get_weather\n  &lt;arg_key&gt;location&lt;/arg_key&gt;\n  &lt;arg_value&gt;Beijing&lt;/arg_value&gt;\n<span class="cm">{# 独立块可解析 #}</span>`},
      { s: S.F, t: "Kimi K2.6 — tool_call 容错",
        d: `arguments 是 JSON 字符串——截断时需要 <code>partial_json_parser</code> 容错。容错结果（补齐引号/括号）与原始 JSON 不同。`,
        e: `生成  {"city": "Beijing", "unit": "cel\n      ↑ JSON 中间截断\n\nparse partial_json_parser → {"city": "Beijing", "unit": "cel"}\n                             ↑ 补齐引号和括号\n\n重建  {"city": "Beijing", "unit": "cel"}\n      ↑ 补齐后的 JSON ≠ 原文`,
        c: `&lt;|tool_call_argument_begin|&gt;\n  {<span class="str">"location"</span>: <span class="str">"Bei</span>\n<span class="cm">{# 截断 → partial_json_parser 补齐 #}</span>\n<span class="cm">{# {"location": "Bei"} ≠ 原文 #}</span>`},
      { s: S.F, t: "DeepSeek V4 Pro — tool_call 容错",
        d: `DSML parser 不容错——参数不完整时正则匹配失败，直接 <code>raise ValueError</code>。`,
        e: `生成  &lt;param name="city" string="true"&gt;Beijing&lt;/param&gt;\\n&lt;param name="unit" string="true"&gt;cel\n      ↑ 第二个参数中间截断\n\nparse regex 匹配 &lt;param&gt;...&lt;/param&gt; 失败（unit 不完整）\n      → ValueError\n      ↑ 不容错，直接报错`,
        c: `param_kv = re.<span class="fn">findall</span>(\n    <span class="str">r'^ name="(.*?)" string=...'</span>,\n    param_content)\n<span class="kw">if</span> <span class="fn">len</span>(param_kv) != 1:\n    <span class="kw">raise</span> <span class="fn">ValueError</span>(...)`},
      { s: S.F, t: "GPT-OSS — tool_call 容错",
        d: `JSON 格式 + vLLM parser 的 <code>json.loads</code> → <code>json.dumps</code> 规范化——即使完整也可能改变格式，截断时更不可控。`,
        e: `生成  {"city": "Beijing", "unit": "cel\n      ↑ JSON 截断\n\nparse json.loads(...) → JSONDecodeError\n      ↑ 无容错机制`,
        c: `<span class="cm"># vLLM parser 规范化</span>\nargs = json.<span class="fn">loads</span>(raw_args)\nnormalized = json.<span class="fn">dumps</span>(args)\n<span class="cm"># 截断时 json.loads 失败</span>`},
    ],
    // scenario 5: tool_call args 序列化
    [
      { s: S.C, t: "Qwen3.6 — args 序列化",
        d: `XML 参数格式避免了 JSON 空格差异。但 vLLM parser 的 <code>ast.literal_eval</code> 做类型强转（<code>True</code> → Python bool → tojson → <code>true</code>）。SGLang 的 Qwen25Detector 用 JSON 格式解析 XML 输出——格式不匹配。`,
        e: `生成  &lt;parameter=verbose&gt;\\nTrue\\n&lt;/parameter&gt;\n\nparse ast.literal_eval("True") → True (Python bool)\n\n模板  True | tojson → "true"\n重建  &lt;parameter=verbose&gt;\\ntrue\\n&lt;/parameter&gt;\n                            ↑ True → true`,
        c: `<span class="kw">{%- set</span> args_value =\n    args_value | <span class="fn">string</span>\n      <span class="kw">if</span> args_value <span class="kw">is</span> string\n      <span class="kw">else</span> args_value | <span class="fn">tojson</span> | safe\n<span class="kw">%}</span>`},
      { s: S.C, t: "GLM-5.1 — args 序列化",
        d: `字符串直接输出，非字符串用 <code>tojson</code>。风险：数字精度（<code>1.0</code> vs <code>1</code>）和中间环节传入字符串化的布尔值。`,
        e: `生成  &lt;arg_value&gt;True&lt;/arg_value&gt;\n\nparse ast.literal_eval("True") → True (Python bool)\n\n重建  &lt;arg_value&gt;true&lt;/arg_value&gt;\n               ↑ tojson: Python True → JSON true`,
        c: `{{ v | <span class="fn">tojson</span>(ensure_ascii=<span class="kw">False</span>)\n    <span class="kw">if</span> v <span class="kw">is not</span> string\n    <span class="kw">else</span> v }}`},
      { s: S.P, t: "Kimi K2.6 — args 序列化",
        d: `vLLM/SGLang parser 都保留原始 JSON 字符串，不做 <code>json.loads</code> → <code>json.dumps</code>。模板 <code>is string</code> 分支直接输出，roundtrip 无损。`,
        e: `生成  {"city":"Beijing","unit":"celsius"}\n\nparse arguments = '{"city":"Beijing","unit":"celsius"}'\n                  ↑ vLLM/SGLang 保留 raw string\n\n模板  is string → 直接输出\n重建  {"city":"Beijing","unit":"celsius"}  ← 一致`,
        c: `<span class="kw">{%- if</span> tool_call[<span class="str">'function'</span>][<span class="str">'arguments'</span>]\n      <span class="kw">is</span> string <span class="kw">%}</span>\n  {{ tool_call[...][<span class="str">'arguments'</span>] }}\n<span class="kw">{%- else %}</span>\n  {{ tool_call[...][<span class="str">'arguments'</span>] | <span class="fn">tojson</span> }}\n<span class="kw">{%- endif %}</span>`},
      { s: S.P, t: "DeepSeek V4 Pro — args 序列化",
        d: `DSML <code>string="true"</code> 标记字符串参数并原样输出，避免 JSON 转义漂移。<code>encode_arguments_to_dsml</code> 和 <code>decode_dsml_to_arguments</code> 是对称函数。`,
        c: `value = v <span class="kw">if</span> <span class="fn">isinstance</span>(v, str) \\\n    <span class="kw">else</span> <span class="fn">to_json</span>(v)\n<span class="cm"># string="true" → 原样输出</span>\n<span class="cm"># string="false" → JSON 编码</span>`},
      { s: S.F, t: "GPT-OSS — args 序列化",
        d: `<code>arguments|tojson</code>——若 arguments 是 JSON 字符串则双重编码；若是 dict，<code>tojson</code> 格式（冒号后空格）可能与模型原文不同。tool response 也有同样的 <code>content|tojson</code> 问题。`,
        e: `生成  {"city":"Beijing"}\n\nparse arguments = '{"city":"Beijing"}'   ← string 类型\n\n模板  arguments|tojson\n重建  "{\\"city\\":\\"Beijing\\"}"   ← 字符串被再次 JSON 编码\n      ↑ 双重编码`,
        c: `{{- tool_call.arguments|<span class="fn">tojson</span> }}\n<span class="cm">{# string → 双重编码 #}</span>\n<span class="cm">{# dict → 格式可能不同 #}</span>`},
    ],
  ];

  const tbody = document.getElementById("drift-tbody");
  const detail = document.getElementById("drift-detail");
  const detailInner = document.getElementById("drift-detail-inner");
  const detailBadge = document.getElementById("drift-detail-badge");
  const detailTitle = document.getElementById("drift-detail-title");
  const detailBody = document.getElementById("drift-detail-body");
  const detailClose = document.getElementById("drift-detail-close");

  let activeCell = null;

  SCENARIOS.forEach((scenario, si) => {
    const tr = document.createElement("tr");
    const tdLabel = document.createElement("td");
    tdLabel.className = "scenario-label";
    tdLabel.textContent = scenario;
    tr.appendChild(tdLabel);

    MODELS.forEach((_, mi) => {
      const td = document.createElement("td");
      const cell = DATA[si][mi];
      const div = document.createElement("div");
      div.className = `drift-cell ${cell.s}`;
      div.textContent = ICON[cell.s];
      div.dataset.si = si;
      div.dataset.mi = mi;
      div.addEventListener("click", () => showDetail(si, mi, div));
      td.appendChild(div);
      tr.appendChild(td);
    });
    tbody.appendChild(tr);
  });

  function showDetail(si, mi, el) {
    const cell = DATA[si][mi];

    if (activeCell) activeCell.classList.remove("active");
    if (activeCell === el) {
      activeCell = null;
      detail.classList.remove("open");
      return;
    }
    activeCell = el;
    el.classList.add("active");

    detailBadge.className = `drift-detail-badge ${cell.s}`;
    detailBadge.textContent = LABEL[cell.s];
    detailTitle.textContent = cell.t;

    let html = `<p>${cell.d}</p>`;
    if (cell.e) html += `<pre class="drift-eg"><code>${cell.e}</code></pre>`;
    if (cell.c) html += `<pre><code>${cell.c}</code></pre>`;
    detailBody.innerHTML = html;

    detail.classList.add("open");
    detail.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }

  detailClose.addEventListener("click", () => {
    if (activeCell) activeCell.classList.remove("active");
    activeCell = null;
    detail.classList.remove("open");
  });
})();
</script>
